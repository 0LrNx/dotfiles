{{- /* Questions posées une seule fois, à `chezmoi init`. Les réponses sont gardées dans ~/.config/chezmoi/chezmoi.toml */ -}}
{{- $name := promptStringOnce . "name" "Nom complet (git)" -}}
{{- $email := promptStringOnce . "email" "Email principal (git)" -}}
{{- $workName := promptStringOnce . "workName" "Nom pour l'identité pro (Azure DevOps, ~/work/)" "" -}}
{{- $workEmail := promptStringOnce . "workEmail" "Email pro (Azure DevOps, ~/work/) (vide = pas d'identité pro)" "" -}}
{{- $signingKey := promptStringOnce . "signingKey" "ID de clé GPG pour signer les commits (vide = pas de signature)" "" -}}

{{- /* Détection de WSL : noyau Linux dont la release contient « microsoft » */ -}}
{{- $osrelease := "" -}}
{{- if hasKey .chezmoi "kernel" -}}
{{-   $osrelease = index .chezmoi.kernel "osrelease" | default "" -}}
{{- end -}}
{{- $isWSL := $osrelease | lower | contains "microsoft" -}}

{{- /* Garde ce dépôt comme source, où qu'il soit cloné (sinon chezmoi cherche ~/.local/share/chezmoi) */}}
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    workName = {{ $workName | quote }}
    workEmail = {{ $workEmail | quote }}
    signingKey = {{ $signingKey | quote }}
    isWSL = {{ $isWSL }}
