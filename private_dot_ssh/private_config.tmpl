# ~/.ssh/config — géré par chezmoi (aucune clé ni secret ici)
# Hôtes propres à la machine : ajouter des fichiers dans ~/.ssh/config.d/
Include config.d/*

{{- if eq .chezmoi.os "darwin" }}
Include {{ .chezmoi.homeDir }}/.colima/ssh_config
{{- end }}

Host *
    AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
    IgnoreUnknown UseKeychain
    UseKeychain yes
{{- end }}
    ServerAliveInterval 60
    ServerAliveCountMax 3
    HashKnownHosts yes
