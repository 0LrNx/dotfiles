# Ghostty — géré par chezmoi. Référence : `ghostty +show-config --default --docs`

# --- Apparence ---
theme = Catppuccin Mocha
font-family = MesloLGS Nerd Font Mono
font-size = 16
font-thicken = true
background-opacity = 0.8
background-blur-radius = 25
# macos-titlebar-style = hidden

# --- Splits (préfixe ctrl+s, façon tmux) ---
keybind = ctrl+s>l=new_split:right
keybind = ctrl+s>h=new_split:left
keybind = ctrl+s>k=new_split:up
keybind = ctrl+s>j=new_split:down
keybind = ctrl+s>p=goto_split:previous
keybind = ctrl+s>n=goto_split:next
keybind = ctrl+s>d=close_window

# --- Ajouts ---
# Option gauche = Alt ; l'Option droite reste libre pour les caractères AZERTY ({ } [ ] | \ ~ @ #)
macos-option-as-alt = left
# `sudo` conserve le terminfo de Ghostty
shell-integration-features = cursor,sudo,title
