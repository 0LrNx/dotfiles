{{ if eq .chezmoi.os "windows" -}}
# Installe les paquets Windows via winget.
# Relancé automatiquement quand .chezmoidata/packages.yaml change.
$ErrorActionPreference = 'Continue'

if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Warning "winget introuvable : installe « Programme d'installation d'applications » depuis le Microsoft Store."
    exit 0
}

$packages = @(
{{ range .packages.windows.winget -}}
    '{{ . }}'
{{ end -}}
)

# Une seule lecture de la liste installée (un `winget list` par paquet est très lent).
$installed = (winget list --accept-source-agreements 2>$null | Out-String)

foreach ($id in $packages) {
    if ($installed -notmatch [regex]::Escape($id)) {
        Write-Host "-> $id"
        winget install --id $id --exact --silent --accept-package-agreements --accept-source-agreements
    }
}

# Rafraîchit le PATH de cette session : les scripts suivants (code, mise…) voient les nouveaux outils.
$env:Path = [Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' + [Environment]::GetEnvironmentVariable('Path', 'User')
{{ end -}}
